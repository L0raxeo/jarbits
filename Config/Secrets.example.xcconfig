// Copy to Config/Secrets.xcconfig (gitignored) and paste your keys. Each
// reaches the app through Browser/Info.plist; see Browser/Router/Secrets.swift.
// Without a key the matching feature is off and the Debug ribbon says so.

// Jev (the router): https://console.typesafe.ai/keys
TYPESAFE_API_KEY = sk-replace-me

// Gemini (narrative and one-line answers): https://aistudio.google.com/apikey
// Pay-as-you-go: the key's project needs billing enabled.
GEMINI_API_KEY = replace-me

// Brave Search (the sites a name might mean, the first time): https://api-dashboard.search.brave.com
// $5 per 1,000 requests with $5 of credit a month; only an unknown site name costs a request.
BRAVE_API_KEY = replace-me
