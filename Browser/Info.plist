<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. Only keys Xcode cannot express as
	     INFOPLIST_KEY_ build settings live here. -->
	<key>TypeSafeAPIKey</key>
	<string>$(TYPESAFE_API_KEY)</string>
	<key>GeminiAPIKey</key>
	<string>$(GEMINI_API_KEY)</string>
	<key>UIDesignRequiresCompatibility</key>
	<true/>
	<!-- Answers use a city-level location so "will it rain today" means here. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your approximate city lets answers about weather, time and nearby things apply to where you are. It is only sent with questions that get a written answer.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
</dict>
</plist>
